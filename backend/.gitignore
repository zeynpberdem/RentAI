# Backend-only .gitignore — Python / Django.
# Paths here are relative to this folder (backend/).

# ---- Environment files (never commit real secrets) ----
.env
.env.local
.env.*.local

# ---- Python / Django ----
venv/
.venv/
__pycache__/
**/__pycache__/
*.pyc
db.sqlite3
staticfiles/
media/

# ---- Editor / OS (root .gitignore kaldırıldı, kurallar buraya taşındı) ----
.vscode/
.idea/
.DS_Store
Thumbs.db
