# ============================================================
# BACKEND environment template (Django)
# ============================================================
# Copy this file to ".env" in the same folder and fill in real values.
# ".env" itself is git-ignored — it must NEVER be committed.
# Every value below is read server-side only. It never reaches the browser.

# --- Django core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL) ---
POSTGRES_DB=fleet_rental_db
POSTGRES_USER=fleet_rental_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- CORS (which frontend origins may call this API) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- AI / LLM provider (secret — backend only, see PDF section 5) ---
LLM_PROVIDER=anthropic
LLM_API_KEY=change-me

# --- Redis / Celery (optional, later weeks) ---
REDIS_URL=redis://localhost:6379/0
