# Frontend-only .gitignore — Node / Vue / Vite.
# Paths here are relative to this folder (frontend/).

# ---- Environment files (never commit real secrets) ----
.env
.env.local
.env.*.local

# ---- Node / Vue ----
node_modules/
dist/
.vite/

# ---- Editor / OS (root .gitignore kaldırıldı, kurallar buraya taşındı) ----
.vscode/
.idea/
.DS_Store
Thumbs.db
