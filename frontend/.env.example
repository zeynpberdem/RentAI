# ============================================================
# FRONTEND environment template (Vue 3 + Vite)
# ============================================================
# Copy this file to ".env" in the same folder.
# IMPORTANT: Vite bundles every "VITE_" variable into the JavaScript
# shipped to the browser. Treat everything here as PUBLIC information.
# Never put secrets, API keys, or credentials in this file.

VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_NAME=Fleet Rental Platform
